# ─── Telegram ─────────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal Telegram chat ID (send /start to @userinfobot to find it)
TELEGRAM_ALLOWED_CHAT_ID=your_chat_id_here

# Dashboard URL sent in Telegram links
# Change this to your local IP when accessing from phone on same network
# e.g. http://192.168.1.10:5173
DASHBOARD_URL=http://localhost:5173

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8101
